FROM mcr.microsoft.com/oss/go/microsoft/golang:1.26.11-bookworm@sha256:b40d917d1b6dcc11590cb3986a498f4858a229feab9f130d3acf68d6db28aa74 AS build
WORKDIR /src
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev-cn-probe
ENV CGO_ENABLED=0 GOEXPERIMENT=nosystemcrypto GOTELEMETRY=off
COPY go.mod go.sum ./
COPY internal/probe ./internal/probe
COPY cmd/narbe-probe ./cmd/narbe-probe
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-w -s -X github.com/pixingzoudaiyuexing/Narbe/internal/probe.Version=$VERSION" -o /out/narbe-probe ./cmd/narbe-probe && mkdir -p /out/data

FROM scratch
ARG VERSION=dev-cn-probe
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Narbe Probe" \
      org.opencontainers.image.source="https://github.com/pixingzoudaiyuexing/Narbe" \
      io.narbe.project="Narbe" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION"
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/narbe-probe /narbe-probe
COPY --from=build --chown=65532:65532 /out/data /data
USER 65532:65532
ENV NARBE_PROBE_DATA_DIR=/data
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["/narbe-probe","healthcheck"]
ENTRYPOINT ["/narbe-probe"]
